        },
        {
            "label": "Run Terraform Apply",
            "type": "shell",
            "command": "terraform",
            "options": {
                "cwd": "${workspaceFolder}/infrastructure/terraform"
            },
            "args": [
                "apply"
            ],
            "problemMatcher": [],
