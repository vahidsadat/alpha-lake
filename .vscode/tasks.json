            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "showReuseMessage": false,
                "clear": false
            }
        },
        {
            "label": "Run Terraform Plan",
            "type": "shell",
            "command": "terraform",
            "options": {
                "cwd": "${workspaceFolder}/infrastructure/terraform"
            },
