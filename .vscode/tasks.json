{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Pipeline locally",
            "type": "shell",
            "command": "python",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "args": [
                "-m",
                "src.pipelines.local"
            ]
        },
        {
            "label": "Run AI Assistant",
            "type": "shell",
            "command": "python",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "args": [
                "-m",
                "src.ai.cli"
            ]
        },
        {
            "label": "Run FastAPI",
            "type": "shell",
            "command": "uvicorn",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "args": [
                "src.api.main:app",
                "--reload",
                "--host",
                "127.0.0.1",
                "--port",
                "8000"
            ],
            "problemMatcher" : []

        },
        {
            "label": "Run Terraform Init",
            "type": "shell",
            "command": "terraform",
            "options": {
                "cwd": "${workspaceFolder}/infrastructure/terraform"
            },
            "args": [
                "init"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "showReuseMessage": false,
                "clear": false
            }
        },
        {
            "label": "Run Terraform Format",
            "type": "shell",
            "command": "terraform",
            "options": {
                "cwd": "${workspaceFolder}/infrastructure/terraform"
            },
